@page "/"
@using Sudoku.Application
@inject TableService TableService

<PageTitle>Sudoku</PageTitle>

<div class="game">
    <aside class="settings">
        <h2>Game</h2>

        <label for="level">Difficulty</label>
        <select id="level" class="form-select" @bind="level" disabled="@isGenerating">
            @foreach (var option in Enum.GetValues<MatchLevelEnum>())
            {
                <option value="@option">@option</option>
            }
        </select>

        <button class="btn btn-primary" disabled="@isGenerating" @onclick="StartNewGame">New game</button>
        <button class="btn btn-outline-danger" disabled="@(game is null || isGenerating)" @onclick="ResetGame">Reset</button>

        <div class="history">
            <button class="btn btn-outline-secondary" disabled="@(!CanUndo)" @onclick="Undo" title="Undo (Ctrl+Z)">Undo</button>
            <button class="btn btn-outline-secondary" disabled="@(!CanRedo)" @onclick="Redo" title="Redo (Ctrl+Y)">Redo</button>
        </div>

        <h3 class="help-title">Help</h3>
        <button class="btn btn-outline-primary" disabled="@(!CanAskForHelp)" @onclick="Check">Check</button>
        <button class="btn btn-outline-primary" disabled="@(!CanAskForHelp || (HintActive && hintDigitShown))" @onclick="ShowHint">@(HintActive && !hintDigitShown ? "Show digit" : "Hint")</button>

        @if (checkMessage is not null)
        {
            <p role="status">@checkMessage</p>
        }
        @if (HintActive)
        {
            <p role="status">@(hintDigitShown ? $"Put {hint!.Digit} in the highlighted cell." : "Look at the highlighted cell.")</p>
        }

        <p class="stats">Checks used: @(game?.ChecksUsed ?? 0)<br />Hints used: @(game?.HintsUsed ?? 0)</p>

        @if (isGenerating)
        {
            <p role="status">Generating a puzzle...</p>
        }
    </aside>

    <section>
        <h1>Sudoku</h1>

        @if (game?.IsSolved() == true)
        {
            <p class="solved" role="status">Solved! Well done.</p>
        }

        @if (game is not null)
        {
            <div class="board-area" tabindex="0" @onkeydown="OnKeyDown">
                <table class="board">
                    @for (int row = 0; row < 9; row++)
                    {
                        <tr>
                            @for (int col = 0; col < 9; col++)
                            {
                                int index = row * 9 + col;
                                int value = game.Values[index];

                                <td class="@CellClass(index)" @onclick="() => Select(index)">@(value == 0 ? "" : value.ToString())</td>
                            }
                        </tr>
                    }
                </table>
            </div>
        }
    </section>
</div>

@code {
    private SudokuGame? game;
    private int? selected;
    private MatchLevelEnum level = MatchLevelEnum.Medium;
    private bool isGenerating;

    // Only a selected cell that is not part of the puzzle can be changed.
    private bool CanEdit => selected is int index && !game!.IsFixed(index);

    // Cells found wrong by the last check, with the wrong digit they held. A mark is shown only while the cell still holds that digit.
    private readonly Dictionary<int, int> marked = new();
    private string? checkMessage;

    // The hint being shown, and what its cell held at that time; the hint ends as soon as the cell changes.
    private Hint? hint;
    private int hintCellValue;
    private bool hintDigitShown;

    private bool HintActive => game is not null && hint is not null && game.Values[hint.Index] == hintCellValue;

    private bool CanAskForHelp => game is not null && !isGenerating && !game.IsSolved();

    private bool CanUndo => game is not null && !isGenerating && game.CanUndo;

    private bool CanRedo => game is not null && !isGenerating && game.CanRedo;

    // The digit in the selected cell (0 when nothing is selected or the cell is empty).
    private int SelectedDigit => selected is int index ? game!.Values[index] : 0;

    // The game is ready as soon as the page loads.
    protected override Task OnInitializedAsync() => StartNewGame();

    private async Task StartNewGame()
    {
        isGenerating = true;

        // Generating a puzzle blocks the browser's single thread. Waiting briefly first lets the
        // "Generating..." message appear before that happens.
        await Task.Delay(50);

        game = new SudokuGame(TableService.StartGame(level));
        selected = null;
        ClearHelp();
        isGenerating = false;
    }

    private void ClearHelp()
    {
        marked.Clear();
        checkMessage = null;
        hint = null;
        hintDigitShown = false;
    }

    // Validate counts as one check. The wrong digits are marked on the board.
    private void Check()
    {
        var mistakes = game!.Validate();

        marked.Clear();
        foreach (var index in mistakes)
            marked[index] = game.Values[index];

        checkMessage = mistakes.Count switch
        {
            0 => "No wrong digits found.",
            1 => "1 wrong digit marked.",
            _ => $"{mistakes.Count} wrong digits marked.",
        };
    }

    // The first click shows the cell and counts as one hint; the second click only reveals its digit.
    private void ShowHint()
    {
        if (HintActive)
        {
            hintDigitShown = true;
            return;
        }

        var next = game!.GetHint();
        if (next is null)
            return;

        hint = next;
        hintCellValue = game.Values[next.Index];
        hintDigitShown = false;
        selected = next.Index;
    }

    private string CellClass(int index)
    {
        var classes = new List<string>();
        if (game!.IsFixed(index))
            classes.Add("fixed");
        if (index == selected)
            classes.Add("selected");
        else if (SelectedDigit != 0 && game.Values[index] == SelectedDigit)
            classes.Add("same-digit");
        if (game.HasConflict(index))
            classes.Add("conflict");
        if (marked.TryGetValue(index, out var wrongDigit) && game.Values[index] == wrongDigit)
            classes.Add("mistake");
        if (HintActive && hint!.Index == index)
            classes.Add("hint");
        return string.Join(" ", classes);
    }

    private void Select(int index) => selected = index;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        // Ctrl+Z undoes, Ctrl+Y and Ctrl+Shift+Z redo (Cmd instead of Ctrl on a Mac).
        if ((e.CtrlKey || e.MetaKey) && !e.AltKey)
        {
            switch (e.Key.ToLowerInvariant())
            {
                case "z" when e.ShiftKey: Redo(); break;
                case "z": Undo(); break;
                case "y": Redo(); break;
            }
            return;
        }

        // Leave other browser shortcuts (Ctrl+R, Alt+Left, ...) alone.
        if (e.CtrlKey || e.AltKey || e.MetaKey)
            return;

        switch (e.Key)
        {
            case "ArrowUp": Move(-1, 0); break;
            case "ArrowDown": Move(1, 0); break;
            case "ArrowLeft": Move(0, -1); break;
            case "ArrowRight": Move(0, 1); break;
            case "0":
            case "Delete":
            case "Backspace":
                ClearSelected();
                break;
            case var key when key.Length == 1 && key[0] >= '1' && key[0] <= '9':
                PlaceDigit(key[0] - '0');
                break;
        }
    }

    // Moves the selection one step; it stops at the edges of the board. With nothing selected it selects the first cell.
    private void Move(int rowStep, int colStep)
    {
        if (selected is not int index)
        {
            selected = 0;
            return;
        }

        int row = Math.Clamp(index / 9 + rowStep, 0, 8);
        int col = Math.Clamp(index % 9 + colStep, 0, 8);
        selected = row * 9 + col;
    }

    private void PlaceDigit(int digit)
    {
        if (!CanEdit)
            return;

        game!.PlaceDigit(selected!.Value, digit);
        checkMessage = null;
    }

    private void Undo()
    {
        if (!CanUndo)
            return;

        game!.Undo();
        checkMessage = null;
    }

    private void Redo()
    {
        if (!CanRedo)
            return;

        game!.Redo();
        checkMessage = null;
    }

    // Back to the puzzle as it was given (same puzzle, not a new one).
    private void ResetGame()
    {
        game!.Reset();
        ClearHelp();
    }

    private void ClearSelected()
    {
        if (!CanEdit)
            return;

        game!.ClearCell(selected!.Value);
        checkMessage = null;
    }
}
