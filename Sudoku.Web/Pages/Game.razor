@page "/game"
@using Sudoku.Application
@inject TableService TableService

<PageTitle>Sudoku</PageTitle>

<h1>Sudoku</h1>

@if (game?.IsSolved() == true)
{
    <p class="solved" role="status">Solved! Well done.</p>
}

@if (game is null)
{
    <p>Loading...</p>
}
else
{
    <div class="board-area" tabindex="0" @onkeydown="OnKeyDown">
    <table class="board">
        @for (int row = 0; row < 9; row++)
        {
            <tr>
                @for (int col = 0; col < 9; col++)
                {
                    int index = row * 9 + col;
                    int value = game.Values[index];

                    <td class="@CellClass(index)" @onclick="() => Select(index)">@(value == 0 ? "" : value.ToString())</td>
                }
            </tr>
        }
    </table>

    <div class="pad">
        @foreach (var digit in Enumerable.Range(1, 9))
        {
            <button class="btn btn-outline-primary" disabled="@(!CanEdit)" @onclick="() => PlaceDigit(digit)">@digit</button>
        }
        <button class="btn btn-outline-secondary" disabled="@(!CanEdit)" @onclick="ClearSelected">Clear</button>
        <button class="btn btn-outline-danger" @onclick="ResetGame">Reset</button>
    </div>
    </div>
}

@code {
    private SudokuGame? game;
    private int? selected;

    // Only a selected cell that is not part of the puzzle can be changed.
    private bool CanEdit => selected is int index && !game!.IsFixed(index);

    // The digit in the selected cell (0 when nothing is selected or the cell is empty).
    private int SelectedDigit => selected is int index ? game!.Values[index] : 0;

    protected override void OnInitialized()
    {
        game = new SudokuGame(TableService.StartGame(MatchLevelEnum.Medium));
    }

    private string CellClass(int index)
    {
        var classes = new List<string>();
        if (game!.IsFixed(index))
            classes.Add("fixed");
        if (index == selected)
            classes.Add("selected");
        else if (SelectedDigit != 0 && game.Values[index] == SelectedDigit)
            classes.Add("same-digit");
        if (game.HasConflict(index))
            classes.Add("conflict");
        return string.Join(" ", classes);
    }

    private void Select(int index) => selected = index;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        // Leave browser shortcuts (Ctrl+R, Alt+Left, ...) alone.
        if (e.CtrlKey || e.AltKey || e.MetaKey)
            return;

        switch (e.Key)
        {
            case "ArrowUp": Move(-1, 0); break;
            case "ArrowDown": Move(1, 0); break;
            case "ArrowLeft": Move(0, -1); break;
            case "ArrowRight": Move(0, 1); break;
            case "0":
            case "Delete":
            case "Backspace":
                ClearSelected();
                break;
            case var key when key.Length == 1 && key[0] >= '1' && key[0] <= '9':
                PlaceDigit(key[0] - '0');
                break;
        }
    }

    // Moves the selection one step; it stops at the edges of the board. With nothing selected it selects the first cell.
    private void Move(int rowStep, int colStep)
    {
        if (selected is not int index)
        {
            selected = 0;
            return;
        }

        int row = Math.Clamp(index / 9 + rowStep, 0, 8);
        int col = Math.Clamp(index % 9 + colStep, 0, 8);
        selected = row * 9 + col;
    }

    private void PlaceDigit(int digit)
    {
        if (CanEdit)
            game!.PlaceDigit(selected!.Value, digit);
    }

    // Back to the puzzle as it was given (same puzzle, not a new one).
    private void ResetGame() => game!.Reset();

    private void ClearSelected()
    {
        if (CanEdit)
            game!.ClearCell(selected!.Value);
    }
}
